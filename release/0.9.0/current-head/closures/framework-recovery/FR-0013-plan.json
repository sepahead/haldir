  "defects": [
    {
      "attempt_timestamp_contract": "CREATED_AT_AND_STARTED_AT_INDEPENDENTLY_BOUNDED_NO_RELATIVE_ORDER_ASSUMED",
      "id": "FR0013-D01",
      "summary": "Epoch 13 imposed an unsupported ordering between GitHub's attempt createdAt and startedAt fields. GitHub can materialize retry metadata after execution starts, so epoch 14 independently bounds both timestamps within the original run lifetime and selected attempt completion."
    },
    {
      "all_job_window": "ORIGINAL_RUN_CREATED_AT_THROUGH_UPDATED_AT",
      "critical_current_attempt_window": "ATTEMPT_STARTED_AT_THROUGH_ATTEMPT_UPDATED_AT",
      "id": "FR0013-D02",
      "ordinary_attempt_job_equality": "EXACT_CANONICAL_EQUALITY",
      "summary": "Epoch 13 bounded all retry jobs to the retry window, but GitHub selective reruns carry successful jobs from earlier attempts into the current attempt response. Epoch 14 bounds every job to the original run window while requiring the current producer and attester to start no earlier than the selected attempt startedAt and complete by its updatedAt."
    },
    {
      "attempts": [
